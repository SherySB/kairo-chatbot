# ---------------------------------------------------------------------------
# Kairo Backend — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit the .env file or the Firebase service-account JSON.
# ---------------------------------------------------------------------------

# Required: absolute path to your Firebase service-account JSON file.
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=/path/to/your/firebase-service-account.json

# Optional: override the log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Optional: host/port for uvicorn (defaults shown)
HOST=0.0.0.0
PORT=8000
